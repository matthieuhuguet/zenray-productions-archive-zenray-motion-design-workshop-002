<!doctype html>
<html lang="fr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Storyboard interface</title>
<style>
@font-face { font-family: 'InterVariable'; src: url('../../ZenRayMotionDesign/fonts/InterVariable.ttf') format('truetype'); font-weight: 100 900; }
@font-face { font-family: 'AnthropicSerif'; src: local('AnthropicSerif-Regular'), local('Anthropic Serif'), url('file:///Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf') format('truetype'); font-weight: 400; }
:root {
  --zr-police-sans: 'InterVariable', 'Hiragino Sans W4', 'Hiragino Sans', sans-serif;
  --zr-police-serif: 'AnthropicSerif', 'Hiragino Mincho ProN W3', serif;
  --zr-poids-sans: 400; --zr-poids-nombres: 400;
  --bg: #f6f5f2; --card: #ffffff; --ink: #1d1d1b; --muted: #6b6a66; --line: #e3e1db; --chip: #efede8;
  --fam-text: #c96a3b; --fam-graphic: #3f7fbf; --fam-plate: #6b8f3a; --fam-montage: #8a5bb0;
  --gutter: 16px; --radius: 12px; --gap: 14px; --size-ui: 14px; --size-small: 12.5px; --size-title: 22px;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #161615; --card: #20201e; --ink: #ecebe7; --muted: #a3a29c; --line: #34332f; --chip: #2b2a27; } }
:root[data-theme="dark"] { --bg: #161615; --card: #20201e; --ink: #ecebe7; --muted: #a3a29c; --line: #34332f; --chip: #2b2a27; }
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: var(--bg); color: var(--ink); }
body { font-family: var(--zr-police-sans); font-weight: var(--zr-poids-sans); font-size: var(--size-ui); line-height: 1.45;
  overflow-x: hidden; }
main { max-width: 1280px; margin: 0 auto; padding: 20px var(--gutter) 48px; }
h1 { font-family: var(--zr-police-serif); font-weight: 350; font-size: var(--size-title); margin: 0 0 6px; overflow-wrap: anywhere; }
p.lead { color: var(--muted); margin: 0 0 14px; max-width: 72ch; }
.num { font-family: var(--zr-police-serif); font-weight: var(--zr-poids-nombres); }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; margin: 0 0 14px; }
.stat { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 8px 10px; min-width: 0; }
.stat b { display: block; font-weight: 400; color: var(--muted); font-size: var(--size-small); }
.stat .num { font-size: 18px; }
.timeline { width: 100%; height: 28px; display: block; margin: 0 0 6px; border-radius: 6px; overflow: hidden; }
.legend { display: flex; flex-wrap: wrap; gap: 10px; color: var(--muted); font-size: var(--size-small); margin: 0 0 18px; }
.legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 5px; vertical-align: -1px; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: var(--gap); }
.card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; min-width: 0; }
.strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; background: var(--line); }
.strip img { width: 100%; height: auto; display: block; aspect-ratio: auto; }
.body { padding: 10px 12px 12px; min-width: 0; }
.head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; margin-bottom: 6px; }
.sid { font-weight: 400; font-size: 15px; }
.fam { font-size: var(--size-small); padding: 1px 8px; border-radius: 99px; color: #fff; }
.times { color: var(--muted); font-size: var(--size-small); }
.desc { margin: 0 0 8px; overflow-wrap: anywhere; }
dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 3px 10px; margin: 0; font-size: var(--size-small); }
dt { color: var(--muted); }
dd { margin: 0; overflow-wrap: anywhere; min-width: 0; }
.chips { display: flex; flex-wrap: wrap; gap: 4px; }
.chip { background: var(--chip); border-radius: 6px; padding: 1px 6px; display: inline-flex; align-items: center; gap: 4px;
  max-width: 100%; overflow-wrap: anywhere; }
.sw { display: inline-block; width: 12px; height: 12px; border-radius: 3px; border: 1px solid var(--line); vertical-align: -2px; }
svg.ease { width: 34px; height: 18px; flex: none; }
svg.ease path { fill: none; stroke: currentColor; stroke-width: 1.6; }
.phases { display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 2px; margin-top: 8px; }
.phases figure { margin: 0; min-width: 0; }
.phases img { width: 100%; display: block; border-radius: 3px; }
.phases figcaption { font-size: 11px; color: var(--muted); }
footer { margin-top: 28px; color: var(--muted); font-size: var(--size-small); overflow-wrap: anywhere; }
</style></head>
